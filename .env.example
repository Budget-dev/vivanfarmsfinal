# ── VIVAAN FARMS ENVIRONMENT CONFIGURATION ──

# --- NimbusPost Shipping Aggregator ---
# Obtain from NimbusPost Seller Panel (Settings -> API)
NIMBUSPOST_TOKEN=
# OR use account credentials for automatic token generation:
NIMBUSPOST_EMAIL=
NIMBUSPOST_PASSWORD=
# Warehouse name registered in NimbusPost (Warehouse / Pickup Locations)
NIMBUSPOST_WAREHOUSE_NAME="Primary Warehouse"
# Optional API endpoint override (Default: https://api.nimbuspost.com/v1)
NIMBUSPOST_API_URL="https://api.nimbuspost.com/v1"

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Google Maps API (Optional: Address Autocomplete & Reverse Geocoding) ---
GOOGLE_MAPS_API_KEY=

# --- Gemini AI / Genkit (Optional: Chatbot / Analytics) ---
GEMINI_API_KEY=
