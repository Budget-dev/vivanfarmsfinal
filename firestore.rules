rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HOW "ADMIN" IS DETERMINED ──────────────────────────────────────────
    // Admin = vivanfarmsnatural@gmail.com or authorized adminRoles document.
    // Checked against the Firebase Auth JWT token email or adminRoles collection.

    // ── Helper Functions ───────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      // Universal override for master admin email or registered admin role
      return isSignedIn()
          && (
            ('email' in request.auth.token
              && request.auth.token.email != null
              && request.auth.token.email.lower() == 'vivanfarmsnatural@gmail.com')
            || exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
          );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── Universal Master Access ────────────────────────────────────────────
    // Grants full read+write to the master admin across ALL collections.
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // ── PRODUCTS ──────────────────────────────────────────────────────────
    // Public catalog browsing for guests and signed-in customers.
    // Full management restricted to administrators.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isMasterAdmin();

      match /variants/{variantId} {
        allow read: if true;
        allow write: if isMasterAdmin();
      }
    }

    // ── REVIEWS ───────────────────────────────────────────────────────────
    // Public reads for store testimonials and moderation views.
    // Customer submission and helpful voting guarded by field checks.
    match /reviews/{reviewId} {
      allow read: if true;

      // Create: signed-in users only with valid rating and non-empty product ID
      allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && 'productId' in request.resource.data
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;

      // Update: Admin full control, or owner editing pending review, or voting helpful
      allow update: if isMasterAdmin()
          || (
            isOwner(resource.data.userId)
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.productId == resource.data.productId
            && request.resource.data.status == 'pending'
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
          )
          || (
            isSignedIn()
            && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['helpfulCount', 'helpfulUsers'])
            && request.resource.data.helpfulCount == resource.data.helpfulCount + 1
            && request.auth.uid in request.resource.data.helpfulUsers
          );

      allow delete: if isOwner(resource.data.userId) || isMasterAdmin();
    }

    // ── FAQS ──────────────────────────────────────────────────────────────
    // Public reads enabled FAQs only; admins read all.
    match /faqs/{faqId} {
      allow read: if resource.data.enabled == true || isMasterAdmin();
      allow create, update, delete: if isMasterAdmin();
    }

    // ── SITE SETTINGS ─────────────────────────────────────────────────────
    // Public read for site-wide settings (announcement bar, logo, contact info).
    // Admin-only write.
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // ── CATEGORIES ────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // ── UNIVERSAL COUPONS ─────────────────────────────────────────────────
    match /universalCoupons/{couponId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // ── USER PROFILES ─────────────────────────────────────────────────────
    match /userProfiles/{userId} {
      allow read, write: if isOwner(userId) || isMasterAdmin();
    }

    // ── COIN TRANSACTIONS ──────────────────────────────────────────────────
    match /coinTransactions/{txId} {
      allow read, list, write: if isMasterAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
    }

    // ── ORDERS ────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow create: if isSignedIn() || (request.resource.data.userId is string && request.resource.data.userId.size() > 0);
      // Allow single document get if master admin, owner, or customer with exact orderId
      allow get: if true;
      // List/queries: Master admin has unrestricted query access; authenticated owners can query their own; or limited lookup (<= 5) for tracking code/phone searches
      allow list: if isMasterAdmin()
          || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid))
          || (request.query.limit != null && request.query.limit <= 5);
      allow update, delete: if isMasterAdmin();
    }

    // ── ADMIN ROLES ───────────────────────────────────────────────────────
    match /adminRoles/{uid} {
      allow get: if isSignedIn();
      allow write: if isMasterAdmin() || (isSignedIn() && 'email' in request.auth.token && request.auth.token.email.lower() == 'vivanfarmsnatural@gmail.com');
    }

  }
}
